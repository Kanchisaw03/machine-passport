# Copy to .env and fill in only the credentials you intend to use.
APP_MODE=local
LLM_PROVIDER=mock
DATA_DIR=data
PUBLIC_BASE_URL=http://localhost:8000

# Gemini Developer API or Vertex AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_QUOTA_BACKEND=local
GEMINI_DAILY_CALL_CAP=60

# Optional integrations
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma3:4b
GCS_BUCKET=
PUBSUB_AUDIT_TOPIC=

# Local request and retention settings
REQUESTS_PER_IP_PER_MINUTE=60
DATA_TTL_DAYS=30
FEEDBACK_ADMIN_TOKEN=
